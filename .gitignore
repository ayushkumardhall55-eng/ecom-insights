/Raw Data/*.csv

# Exclude cleaned datasets
/cleaned_data/*.csv

# Exclude Python cache files
__pycache__/
*.py[cod]

# Exclude Jupyter checkpoint files
.ipynb_checkpoints/
*-checkpoint.ipynb

